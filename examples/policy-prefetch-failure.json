  "workload": {
    "type": "synthetic",
    "profile": "kv_cache_decode",
    "model": {
      "name": "llama-3-70b",
      "family": "llama",
      "layers": 80,
      "attention_heads": 64,
      "kv_heads": 8,
      "head_dim": 128,
      "dtype_bytes": 2
    },
    "requests": {
      "arrival_rate_per_second": 12,
      "concurrency": 24,
      "prompt_tokens": 4096,
      "generated_tokens": 1024,
      "phase_mix": {
        "prefill": 0.05,
        "decode": 0.95
      }
    }
  },
  "policy": {
    "name": "predictive_prefetch",
    "params": {
      "confidence_threshold": 0.5,
      "lookahead_pages": 8,
      "max_in_flight_prefetches": 256,
      "prefetch_window_pages": 4,
      "cancel_on_pressure": false,
      "stream": "workload"
    }
  },
  "faults": {
    "node_failures": [],
    "link_degradations": [],
    "packet_loss": {
      "enabled": false,
      "ppm": 0
    }
  },
  "metrics": {
    "percentiles": [
      50,
      95,
      99
