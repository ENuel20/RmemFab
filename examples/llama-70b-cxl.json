  "workload": {
    "type": "synthetic",
    "profile": "kv_cache_decode",
    "model": {
      "name": "llama-3-70b",
      "family": "llama",
      "layers": 80,
      "attention_heads": 64,
      "kv_heads": 8,
      "head_dim": 128,
      "dtype_bytes": 2
    },
    "requests": {
      "arrival_rate_per_second": 8,
      "concurrency": 16,
      "prompt_tokens": 4096,
      "generated_tokens": 512,
      "phase_mix": {
        "prefill": 0.1,
        "decode": 0.9
      }
    }
  },
  "policy": {
    "name": "hot_cold",
    "params": {
      "hot_threshold": 8,
      "cold_threshold": 1,
      "tick_ns": 1000000,
      "min_residency_ns": 10000000,
      "max_migrations_per_tick": 64
    }
  },
  "faults": {
    "node_failures": [],
    "link_degradations": [],
