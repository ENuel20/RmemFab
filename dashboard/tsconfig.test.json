{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/components/comparison/latencyTerminologyAndClarity.test.ts",
    "src/components/comparison/migrationTerminologyAndApiContract.test.ts",
    "src/utils/comparisonMetrics.ts",
    "src/services/contractValidators.ts",
    "src/types/telemetry.ts",
    "src/types/scenario.ts"
  ]
}
